<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FocusPlus.Desktop.Views.ShellView">
  <Grid ColumnDefinitions="224,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource EmeraldBrush}" Padding="18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="FocusPlus" Foreground="White" FontSize="24" FontWeight="SemiBold" />
          <TextBlock x:Name="SideSubtitle" Foreground="#C8E2DA" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,30,0,0" Spacing="4">
          <TextBlock Text="—" Foreground="#77B9AA" FontSize="10" Margin="14,0,0,4" />
          <Button x:Name="NavDashboard" Classes="side-nav" Click="Nav_Click" Tag="dashboard" />
          <Button x:Name="NavTerminals" Classes="side-nav" Click="Nav_Click" Tag="terminals" />
          <Button x:Name="NavEmployees" Classes="side-nav" Click="Nav_Click" Tag="employees" />
          <Button x:Name="NavAttendance" Classes="side-nav" Click="Nav_Click" Tag="attendance" />
          <Button x:Name="NavSettings" Classes="side-nav" Click="Nav_Click" Tag="settings" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="6">
          <Button x:Name="LangButton" Classes="side-nav" Click="Lang_Click" />
          <Button x:Name="SignOutButton" Classes="side-nav" Click="SignOut_Click" />
          <TextBlock x:Name="OperatorText" Foreground="#A9D4C8" FontSize="11" Margin="14,8,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1" RowDefinitions="64,*,40">
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
              Padding="24,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Classes="page-title" VerticalAlignment="Center" />
            <TextBlock x:Name="PageSubtitle" Classes="subtle" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Classes="subtle" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl x:Name="PageHost" Grid.Row="1" Margin="22" />

      <Border x:Name="SnackBar" Grid.Row="2" Background="{DynamicResource EmeraldDeepBrush}"
              IsVisible="False" Padding="22,0">
        <TextBlock x:Name="SnackText" Foreground="White" FontSize="12" VerticalAlignment="Center" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
