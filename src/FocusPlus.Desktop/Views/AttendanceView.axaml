<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FocusPlus.Desktop.Views.AttendanceView">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*">

      <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="TodayButton" Classes="ghost" Command="{Binding TodayCommand}" />
            <Button x:Name="WeekButton" Classes="ghost" Command="{Binding WeekCommand}" />
            <Button x:Name="MonthButton" Classes="ghost" Command="{Binding MonthCommand}" />
            <TextBlock Text="{Binding SummaryText}" Classes="subtle" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="ExportCsvButton" Classes="ghost" Click="ExportCsv_Click"
                    IsEnabled="{Binding !IsBusy}" />
            <Button x:Name="ExportHtmlButton" Classes="ghost" Click="ExportHtml_Click"
                    IsEnabled="{Binding !IsBusy}" />
            <Button x:Name="RefreshButton" Classes="primary" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Grid.Row="1" Text="{Binding SummaryText}" Classes="subtle" Margin="4,0,4,10" />

      <Border Grid.Row="2" Classes="card">
        <Grid>
          <ListBox x:Name="AttendanceList" ItemsSource="{Binding Rows}"
                   SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                   SelectionChanged="AttendanceList_SelectionChanged"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="1.7*,1*,1*,1*,1*,Auto" ColumnSpacing="8" Margin="0,7">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding DateText}" Classes="subtle technical"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding DayText}" Classes="subtle" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding TotalText}" Classes="technical"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding ExtraText}" Classes="subtle technical"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel x:Name="EmptyPanel" IsVisible="False" Spacing="10" MaxWidth="380"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyTitle" Classes="state-title" />
            <TextBlock x:Name="EmptyHint" Classes="state-hint" />
            <Button x:Name="EmptyAction" Classes="primary" Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Center" />
          </StackPanel>

          <Border x:Name="LoadingPanel" IsVisible="False" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="180" />
              <TextBlock x:Name="LoadingText" Classes="state-hint" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- In-page detail drawer: right in French LTR, left in Arabic RTL (set from code-behind) -->
    <Border x:Name="Drawer" Classes="drawer" IsVisible="{Binding IsDetailOpen}" Width="520"
            HorizontalAlignment="Right">
      <ScrollViewer>
        <StackPanel Spacing="10" KeyboardNavigation.TabNavigation="Cycle">
          <TextBlock Text="{Binding DetailTitle}" Classes="section-title" />
          <TextBlock Text="{Binding DetailSubtitle}" Classes="subtle" />
          <Border Classes="soft">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding DetailTimes}" Classes="technical" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DetailTotals}" Classes="technical" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DetailStatus}" />
              <TextBlock Text="{Binding DetailNotes}" Classes="subtle" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock x:Name="PunchesLabel" Classes="kpi-label" />
          <ItemsControl ItemsSource="{Binding DetailPunches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4">
                  <TextBlock Text="{Binding Time}" Classes="technical" />
                  <TextBlock Grid.Column="1" Text="{Binding State}" Classes="subtle" />
                  <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="subtle" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="ManualLabel" Classes="kpi-label" Margin="0,8,0,0" />
          <TextBox x:Name="ManualTimeBox" Text="{Binding ManualTime}" Watermark="HH:mm"
                   Classes="technical" />
          <TextBox x:Name="ManualNoteBox" Text="{Binding ManualNote}" />
          <Button x:Name="AddManualButton" Classes="primary" Click="AddManual_Click" />

          <Button x:Name="CloseButton" Classes="ghost" Command="{Binding CloseDetailCommand}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
