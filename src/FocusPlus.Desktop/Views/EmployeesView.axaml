<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FocusPlus.Desktop.Views.EmployeesView">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*">

      <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBox x:Name="SearchBox" Width="240" Text="{Binding Search}" />
            <TextBlock Text="{Binding CountText}" Classes="subtle" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="NewButton" Classes="primary" Command="{Binding NewCommand}" />
            <Button x:Name="RefreshButton" Classes="ghost" Command="{Binding RefreshCommand}" />
            <Button x:Name="ImportButton" Classes="ghost" Command="{Binding ImportFromDeviceCommand}" />
            <Button x:Name="ClearButton" Classes="ghost" Command="{Binding ClearFiltersCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <CheckBox Grid.Row="1" x:Name="ArchivedCheck" IsChecked="{Binding ShowArchived}"
                Margin="4,0,0,10" />

      <Border Grid.Row="2" Classes="card">
        <ListBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="2*,1.2*,1*,1*,Auto" Margin="0,7">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Department}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Shift}" Classes="subtle" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Pin}" Classes="subtle" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <Border Classes="card" IsVisible="{Binding IsDrawerOpen}" Width="480"
            HorizontalAlignment="Right" VerticalAlignment="Stretch" ZIndex="10">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding DrawerTitle}" Classes="section-title" />
          <TextBlock Text="{Binding EditingSubtitle}" Classes="subtle" />

          <TextBlock x:Name="ArNameLabel" Classes="kpi-label" />
          <TextBox Text="{Binding Editing.DisplayNameAr}" />
          <TextBlock x:Name="FrNameLabel" Classes="kpi-label" />
          <TextBox Text="{Binding Editing.DisplayNameFr}" />
          <TextBlock x:Name="MatriculeLabel" Classes="kpi-label" />
          <TextBox Text="{Binding Editing.Matricule}" IsEnabled="{Binding CanEditMatricule}" />
          <TextBlock x:Name="PinLabel" Classes="kpi-label" />
          <TextBox Text="{Binding Editing.DevicePin}" />

          <TextBlock x:Name="DaysLabel" Classes="kpi-label" Margin="0,8,0,0" />
          <WrapPanel>
            <CheckBox Content="Sun" IsChecked="{Binding Sun}" Margin="0,0,12,0" />
            <CheckBox Content="Mon" IsChecked="{Binding Mon}" Margin="0,0,12,0" />
            <CheckBox Content="Tue" IsChecked="{Binding Tue}" Margin="0,0,12,0" />
            <CheckBox Content="Wed" IsChecked="{Binding Wed}" Margin="0,0,12,0" />
            <CheckBox Content="Thu" IsChecked="{Binding Thu}" Margin="0,0,12,0" />
            <CheckBox Content="Fri" IsChecked="{Binding Fri}" Margin="0,0,12,0" />
            <CheckBox Content="Sat" IsChecked="{Binding Sat}" />
          </WrapPanel>

          <WrapPanel>
            <Button x:Name="SaveButton" Classes="primary" Command="{Binding SaveCommand}" Margin="0,8,8,0" />
            <Button x:Name="ArchiveButton" Classes="ghost" Command="{Binding ArchiveCommand}" Margin="0,8,8,0" />
            <Button x:Name="CloseButton" Classes="ghost" Command="{Binding CloseDrawerCommand}" Margin="0,8,8,0" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
