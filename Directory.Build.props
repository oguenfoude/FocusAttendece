<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NeutralLanguage>fr-DZ</NeutralLanguage>
    <Company>OPGI M'Sila</Company>
    <Product>Focus Attendance</Product>
    <Copyright>OPGI M'Sila</Copyright>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en;fr;ar</SatelliteResourceLanguages>
    <!-- Quality gate: the build must stay warning-free. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1848;CA2007;CA1031;CA1303;CA1305;CA1310;CA5394;CA1861</NoWarn>
  </PropertyGroup>

</Project>
